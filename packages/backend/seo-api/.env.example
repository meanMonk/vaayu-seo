# Copy to .env and edit. Kept in git as a reference.
PORT=3400
SERVICE_NAME=seo-api
DB_TYPE=none
DB_NAME=app_seo-api

# ------------------------------------------------------------------
# Mongo — ONE canonical URI, two targets:
#   local dev (brew mongod) : 127.0.0.1, no auth  (creds are ignored)
#   docker / VPS            : `mongo` on vaayu_db  (container name)
# After `sudo bash scripts/hosts-local.sh`, `mongo` -> 127.0.0.1 so the
# SAME `mongo:27017` URI works both in docker and via brew.
# ------------------------------------------------------------------
MONGODB_URI=mongodb://seo-api:change_me@mongo:27017/app_seo-api?authSource=app_seo-api

# Postgres (only when DB_TYPE=postgres)
#   local dev (brew) : 127.0.0.1  |  docker/VPS: `postgres` on vaayu_db
PG_URI=postgres://seo-api:change_me@postgres:5432/app_seo-api

# Docs
OPENAPI_TITLE=seo-api API

# Google PageSpeed Insights (FREE, optional). The API works without a key
# (~25k req/day). Create a free key in Google Cloud Console (no billing) and
# set it here to raise the quota.
PAGESPEED_API_KEY=
