# Copy to .env and edit. Frontend env is baked at build time (VITE_*).
# Local dev: talk straight to the API. In docker/VPS, nginx proxies /api → seo-api:3400.
VITE_API_URL=http://localhost:3400
# GA4 Measurement ID shared across Vaayu sites (e.g. G-XXXXXXXXXX).
# The app always sends page_title "SEO Checkup | seo.vaayulabs.com" + site
# "seo.vaayulabs.com" so this property's traffic stays distinguishable.
# Empty = analytics disabled.
VITE_GA4_ID=G-YXSGML4X6W
