# Platform-level env — used by docker-compose.infra.yml + apps (docker).
# Copy to .env and edit. Local dev via brew does NOT need this file:
#   run `bash scripts/db-info.sh` and `sudo bash scripts/hosts-local.sh` once.

# Mongo (docker infra + VPS)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_me_root

# Mongo-express web UI (db.<domain>)
DB_UI_USER=admin
DB_UI_PASSWORD=change_me_dbui

# MinIO object storage (files.<domain>)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me_minio

# Routing / domains (used by nginx-setup.ts + vps scripts)
VA_DOMAIN=vaayulabs.com
